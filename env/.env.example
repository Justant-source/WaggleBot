# WaggleBot 환경 변수 — cp .env.example .env 후 실제 값 입력
DATABASE_URL=mysql+pymysql://wagglebot:wagglebot@db/wagglebot
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# LLM (Claude CLI bridge)
LLM_WORKER_URL=http://llm-worker:8090
LLM_MODEL=haiku
CLAUDE_HOST_CONFIG_DIR=/home/justant/.claude

# TTS — Fish Audio S2-pro only (S1-mini VRAM 로드 금지, fish-speech 병렬 기동 금지)
TTS_ENGINE=fish-speech
FISH_SPEECH_URL=http://fish-speech:8080

# 크롤러
ENABLED_CRAWLERS=nate_pann,bobaedream,dcinside,fmkorea
CRAWL_INTERVAL_HOURS=1

# 비디오
VIDEO_GEN_ENABLED=false

# 외부 ingest API (/api/external/**, backend) — 로컬 기본값 change-me-external
EXTERNAL_API_KEY=change-me-external

# 텔레그램 브리지 (telegram-bridge 서비스 전용)
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
LOG_LEVEL=info
HOOKS_PORT=3847

# ASM(Again-Spring-Marketing) 마케팅 redrive/ignore 콜백 forwarder — 이 봇 토큰의
# getUpdates poller가 없는 ASM 대신 telegram-bridge가 콜백을 그대로 중계
ASM_TELEGRAM_CALLBACK_URL=http://100.115.252.61:8200/api/v1/telegram/callback
ASM_BEARER_TOKEN=
